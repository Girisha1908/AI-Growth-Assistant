# ── Database (safe local defaults) ────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth

# ── Model provider: ollama (default, local, free) | claude | claude-agent ──
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=8192
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Cloud (OPTIONAL). Leave blank to stay fully local. Never commit a real key. ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ── Retrieval tuning (OPTIONAL) ───────────────────────────────────
# Best vector hit farther than this => the assistant refuses instead of guessing.
RELEVANCE_MAX_DISTANCE=0.45
RETRIEVAL_TOP_K=4

# ── Ship 30 skill (OPTIONAL): sectioned reaches ~1,250 words on small models ──
SHIP30_STRATEGY=sectioned
SHIP30_TARGET_WORDS=1250

LOG_LEVEL=INFO
